# 复制本文件为 .env.local 并填写真实值（.env.local 已被 git 忽略，不会提交）

# 扣子访问令牌（机密，只在后端环境变量中读取，严禁写进前端代码）
COZE_PAT=你的扣子个人访问令牌

# --- 以下两项也可在 src/lib/coze-config.ts 中直接填写 ---
# 扣子工作流 ID
WORKFLOW_ID=你的工作流ID

# 工作流「开始」节点的输入参数名
COZE_INPUT_PARAM=context

# 扣子 API 地址（国内版默认，国际版改为 https://api.coze.com/v1/workflow/run）
# COZE_API_BASE=https://api.coze.cn/v1/workflow/run